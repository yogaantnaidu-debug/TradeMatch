# Copy to .env and change the password. .env is git-ignored.
POSTGRES_USER=tradesync
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tradesync
POSTGRES_PORT=5432

# The Python code reads only this variable (from this file, or from the environment).
# Its password MUST equal POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://tradesync:change_me@localhost:5432/tradesync
